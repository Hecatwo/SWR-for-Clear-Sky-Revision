[wpn_pkm]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection     = spawn_group
discovery_dependency    =
$spawn                                                = "weapons\pkm"                ; option for Level Editor
$npc                    = on                                ; option for Level Editor
$prefetch               = 8
scheduled               = off                                ; option for ALife Simulator
cform                   = skeleton
class                   = WP_AK74
min_radius              = 30
max_radius              = 100
description             = st_wpn_rp_descr

ef_main_weapon_type     = 2
ef_weapon_type          = 6

default_to_ruck         = false
sprint_allowed          = true

;---DOF-------------------------------------------------------------------------
zoom_dof                = 0.5, 1.0, 180
reload_dof              = 0.0, 0.5, 5, 1.7
;-------------------------------------------------------
upgrades                = up_gr_a_pkm, up_gr_b_pkm, up_gr_c_pkm, up_gr_d_pkm, up_gr_e_pkm
installed_upgrades      =
upgrade_scheme          = upgrade_scheme_u8

; MTB-Damian.Romanik [JUD-381]: config for gunsmith achievement
full_upgrade_musthave	= up_abcd_pkm, up_e_pkm

;-------------------------------------------------------------------------------
holder_range_modifier   = 1.0                       ; во сколько раз увеличивается eye_range
holder_fov_modifier     = 0.7              ; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

cost                    = 50000
weapon_class            = assault_rifle        ; Type of the weapon

ammo_limit              = 300
ammo_current            = 200
ammo_elapsed            = 100

ammo_mag_size           = 100
ammo_class              = ammo_pkm_100
grenade_class           = ammo_m209
fire_modes              = -1
launch_speed            = 0
hand_dependence         = 1
single_handed           = 0

slot                    = 2                ; // secondary
animation_slot          = 2                ; type of the animation that will be used

inv_name                = st_wpn_rp
inv_name_short          = st_wpn_rp
inv_weight              = 7.5

inv_grid_width          = 6
inv_grid_height         = 2
inv_grid_x              = 0
inv_grid_y              = 36

kill_msg_x              = 80
kill_msg_y              = 59
kill_msg_width          = 87
kill_msg_height         = 24

;-------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base    = 0.85        ;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
control_inertion_factor = 3.0f ; 2.2f

;отдача
cam_relax_speed         = 15               ;скорость возврата в исходное положение
cam_relax_speed_ai      = 360                ;скорость возврата в исходное положение у АИ
cam_dispersion          = 1.0                ;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc      = 1.3                ;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac     = 1.0                ;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle           = 5.0                ;максимальный угол отдачи
cam_max_angle_horz      = 15.0                ;(degree) maximum shot horizontal degree
cam_step_angle_horz     = 1.8                    ;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor = 5        ;увеличение дисперсии в процентах при максимальном износе
misfire_probability     = 0.001        ;вероятность осечки при максимальном износе
misfire_condition_k     = 0.01
condition_shot_dec      = 0.0001 ;увеличение износа при каждом выстреле
;-------------------------------------------------------------------------------

position                = -0.027, -0.097, 0.042
orientation             = 0, -2, 0

fire_point              = 0.0, 0.158, 0.845 ;0.000000,0.137000,0.649000
fire_point2             = 0.0, 0.097, 0.722

flame_particles         = weapons\generic_weapon05
smoke_particles         = weapons\generic_shoot_00
grenade_flame_particles = weapons\generic_weapon01

shell_point             = -0.020000,0.167000,0.082000
shell_dir               = 0.0, 0.0, 0.4
shell_particles         = weapons\generic_shells

PDM_disp_base           = 1.5
PDM_disp_vel_factor     = 2.45
PDM_disp_accel_factor   = 2.45
PDM_disp_crouch         = 0.2
PDM_disp_crouch_no_acc  = 0.2

; ttc
hit_power              = 1, 1, 1, 1
hit_impulse            = 120
hit_type               = fire_wound

hit_probability_gd_novice  = 0.80
hit_probability_gd_stalker = 0.80
hit_probability_gd_veteran = 0.80
hit_probability_gd_master  = 0.80

fire_distance           = 150
bullet_speed            = 450        ;начальная скорость пули
rpm                     = 600
rpm_empty_click         = 200
; end ttc

use_aim_bullet          = false ;true                ;Поддерживается ли первая суппер пуля

time_to_aim             = 5.0

hud                     = wpn_pkm_hud


;--STRAP PARAMETERS-----------------------------------------------------------------
;под мишкой
strap_position          = -0.26,-0.11,0.25                                ; position (offset) and orientation of the weapon when it is strapped
strap_orientation       = -15,-9,110                                        ; (3rd person view in degrees)
strap_bone0             = bip01_spine2
strap_bone1             = bip01_spine1

startup_ammo            = 90
visual                  = dynamics\weapons\wpn_pkm\wpn_pkm.ogf

light_disabled                                = false
light_color             = 0.6,0.5,0.3
light_range             = 5
light_var_color         = 0.05
light_var_range         = 0.5
light_time              = 0.2

ph_mass                 = 4
;cost                   = 2100

;addons
scope_status            = 0
silencer_status         = 0
grenade_launcher_status = 0

zoom_enabled            = true                                                ; (on,off)zoom mode (right mouse button)
zoom_rotate_time        = 0.3
scope_zoom_factor       = 75                                                ; (on,off)zoom mode (right mouse button)

;звуки
snd_draw                = weapons\generic_draw
snd_holster             = weapons\generic_holster
snd_shoot               = weapons\pkm_shot
snd_empty               = weapons\gen_empty, 0.5
snd_reload              = weapons\pkm\pkm_reload_full

;настройки для глушителя
silencer_hit_power      = 0.55, 0.55, 0.55, 0.55
silencer_hit_impulse    = 120
silencer_fire_distance  = 250
silencer_bullet_speed   = 600

;silencer_flame_particles  = weapons\generic_weapon01
silencer_smoke_particles   = weapons\generic_shoot_00

snd_silncer_shot        = weapons\n_762_sil

silencer_light_color    = 0.6,0.5,0.3
silencer_light_range    = 0.01
silencer_light_var_color= 0.05
silencer_light_var_range= 0.5
silencer_light_time     = 0.2


[wpn_pkm_hud]:hud_base
zoom_hide_crosshair        	= true
attach_place_idx        	= 0
item_visual                	= dynamics\weapons\wpn_pkm\wpn_pkm_hud

item_position               		= 0, 0, 0
item_orientation            		= 0, 0, 0
		
hands_position_16x9 = -0.195400,0.072500,0.007500
hands_orientation_16x9 = 0.000000,-0.450000,0.000000
hands_position = -0.195400,0.072500,0.007500
hands_orientation = 0.000000,-0.450000,0.000000

aim_hud_offset_pos_16x9 = -0.085133,0.052422,-0.038662
aim_hud_offset_rot_16x9 = -0.006583,-0.001972,-0.181152
aim_hud_offset_pos = -0.085133,0.052422,-0.038662
aim_hud_offset_rot = -0.006583,-0.001972,-0.181152

lean_hud_offset_pos         		= 0, 0, 0
lean_hud_offset_rot         		= 0, 0, 0

shell_bone                  		= gilza
shell_bone2                  		=  holder
shell_dir                   		= 0, 11, 0
shell_point                 		= 200, 200, 200

fire_bone                   		= wpn_body
fire_bone2                  		= wpn_body
fire_point = 0.001500,0.031100,0.730200
fire_point2 = 0.000000,0.000000,0.000000

anm_show                     	= pkm_draw, draw
anm_hide                     	= pkm_hide, hide
anm_idle                     	= pkm_idle, idle
anm_idle_sprint         	 	= pkm_sprint, sprint
anm_idle_moving                 = pkm_walk, walk
anm_shots               		= pkm_shoot_aim
anm_reload              		= pkm_reload_empty, reload_empty_new
anm_idle_aim                   	= pkm_idle_aim, idle
anm_bore                        = pkm_idle_bore, idle

