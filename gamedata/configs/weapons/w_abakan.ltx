hit_probability_gd_veteran = 0.80
hit_probability_gd_master  = 0.80

fire_distance           = 150                  ; maximum fire distance that bullet can fly
bullet_speed            = 400                ; starting bullet speed
rpm                     = 650
rpm_empty_click         = 200
; end ttc

use_aim_bullet          = true                ;Поддерживается ли первая суппер пуля
time_to_aim             = 3.0

